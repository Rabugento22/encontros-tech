{
  "mcpServers": {
    "k8s": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "--user",
        "1000:1000",
        "-e",
        "HOME=/home/appuser",
        "-v",
        "${HOME}/.kube:/home/appuser/.kube:ro",
        "flux159/mcp-server-kubernetes"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}